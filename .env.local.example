# ─── Template white-label (équipe de courtiers) ─────────────────────────
# Copier vers .env.local et remplir au déploiement.
# Toutes ces valeurs sont propres à CHAQUE déploiement/client.

# ─── IA (rapport /analyze) ──────────────────────────────────────────────
# Optionnel — sans clé, l'app utilise un rapport déterministe de repli.
ANTHROPIC_API_KEY=

# ─── Webhook CRM (GHL) — /lead ──────────────────────────────────────────
# Sans URL, les leads qualifiés sont seulement logés côté serveur.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Tracking / analytics (injectés seulement si renseignés) ────────────
# Meta Pixel ID (Advanced Matching hashé côté Meta à la soumission)
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity — ID de projet
NEXT_PUBLIC_CLARITY_ID=
# Clarity Scanner — nom de projet (défaut : BRAND.slug de lib/brand.ts)
NEXT_PUBLIC_CLARITY_SCANNER_PROJECT=

# ─── SEO / Open Graph ───────────────────────────────────────────────────
# URL publique du déploiement (metadataBase)
NEXT_PUBLIC_SITE_URL=

# ─── À personnaliser AUSSI (hors .env) ──────────────────────────────────
# lib/brand.ts   → nom d'équipe, région/ville, hero, courtiers, logos, carte
# lib/regions.ts → liste des secteurs/municipalités couverts
# app/globals.css → palette (bloc @theme) si autre chose que noir/doré/blanc
# lib/brand.ts   → wordmark (signature texte, pas de logo image)
